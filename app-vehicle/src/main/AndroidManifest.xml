<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android Automotive OS 전용 앱 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- AAOS 표준 Car API: 기어(GEAR_SELECTION), 속도(PERF_VEHICLE_SPEED) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />

    <!--
      Pleos Vehicle SDK 권한 (사용하는 도메인만 선언)
      https://document.pleos.ai/en/docs/pleos-only/connect-sdk-pleos/Vehicle/vehicle-permission
      Door → CAR_DOORS / Fuel·EvBattery → CAR_ENERGY / Safety·Tire → CAR_SAFETY / Brake·Odometer → CAR_DRIVE
    -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 휴게소 경유지 추가(NaviHelper)와 보호자 알림 위치(FusedLocation) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- 말로 남기는 메모 (SpeechToText, 차량 내장 인식 엔진) -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <application
        android:name=".CarRelayApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarRelay">

        <!-- AAOS Car API 라이브러리 (없는 기기에서도 설치되도록 required=false) -->
        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize">

            <!--
              주행 중에도 화면을 유지합니다. 대신 앱이 CarUxRestrictions 를 구독해
              주행 중에는 선택·메모 화면을 숨기고 음성 + 큰 버튼 2개만 남깁니다.
            -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
